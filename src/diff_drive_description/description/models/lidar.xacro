<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    

    <!-- Properties -->

    <xacro:property name="mesh_file_lidar"
                  value="file://$(arg mesh_path)/description/meshes/lidar.stl"/>

    <xacro:property name="lidar_x" value="0.0"/>
    <xacro:property name="lidar_y" value="0.0"/>
    <xacro:property name="lidar_z" value="0.10"/>

    <xacro:property name="lidar_mass" value="0.10"/>
    <xacro:property name="lidar_radius" value="0.03685"/>
    <xacro:property name="lidar_height" value="0.0455"/>

    <xacro:property name="mesh_scale" value="1 1 1"/>

    <!-- Material -->

    <material name="lidar_material">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <!-- LiDAR -->

    <joint name="lidar_joint" type="fixed">
        <parent link="chassis"/>
        <child link="lidar_link"/>
        <origin xyz="0 -0.50725 0.02" rpy="0 0 0"/>
    </joint>

    <link name="lidar_link">

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <!-- <mesh filename="package://diff_bot_description/description/meshes/lidar.stl"/> -->
                <mesh filename="${mesh_file_lidar}"/>
            </geometry>
            <material name="lidar_material"/>
        </visual>

        <collision>
            <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
            </geometry>
        </collision>

        <xacro:inertial_cylinder
             mass="0.1" 
             radius="${lidar_radius}" 
             length="${lidar_height}">
            <origin xyz="0.0 0.0 ${lidar_height/2}"/>
      </xacro:inertial_cylinder>

    </link>

</robot>